# CommitLint.ai Environment Configuration Template
# Copy this file to .env and insert your personal Google Gemini API key.

# Required: Google Gemini API Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server Port (defaults to 8080)
PORT=8080

# Optional: Gemini Model identifier (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

